name "vello-d"
description "Dlang bindings for Vello vector graphics"
authors "amdphreak"
copyright "Copyright © 2026, amdphreak"
license "MIT"
version "0.1.4"
# Keep in sync with git tag v0.1.4. Publish to code.dlang.org after tagging.

targetType "library"
targetName "vello_d"

preBuildCommands "cargo build --release --manifest-path vello_bridge/Cargo.toml"

importPaths "source"
sourcePaths "source"

platform "windows" {
    lflags "/LIBPATH:$PACKAGE_DIR/vello_bridge/target/release"
    libs "vello_bridge" "advapi32" "userenv" "ws2_32" "bcrypt" "ntdll"
}

platform "posix" {
    lflags "-L$PACKAGE_DIR/vello_bridge/target/release"
    libs "vello_bridge" "pthread" "dl" "m"
}
